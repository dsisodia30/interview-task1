// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../../db/sqlite.db"
}

model Reservation {
  id                Int     @id @default(autoincrement())
  betriebId         Int
  status            String
  gastId            Int
  peopleCount       Int
  msg               String?
  notes             String?
  tags              String?
  reservedFor       String
  shiftId           Int?
  roomId            Int?
  stayTime          Int?
  userPerSmsInform  String?
  isTablePlan       String?
  feedbackHash      String?
  feedbackSent      String?
  addOns            String?
  orderId           Int?
  createdAt         String
  hash              String
  locked            Int
  paymentTemplate   Int?
  paymentId         Int?
  invoice           Float?
  recurrenceId      Int?
  source            String?
  turnover          Float?
  children          Int?
  highChairs        Int?
  resHotelID        Int?
  referrer          String?

  @@map("reservations")
}
